# ---------------------------------------------------------------
# packer/student.pkrvars.hcl.example
#
# LAB-3931 — Student variable file template
#
# STEP 1 — Copy this file:
#   cp student.pkrvars.hcl.example student.pkrvars.hcl
#
# STEP 2 — Edit student.pkrvars.hcl — set your student_id
#           Leave ibm_api_key = "" (it is exported from Vault below)
#
# STEP 3 — Export all credentials from Vault:
#   export IBM_API_KEY=$(vault kv get -namespace=admin -mount=kv -field=ibm_api_key IBM_cloud)
#   export HCP_CLIENT_ID=$(vault kv get -namespace=admin -mount=kv -field=client_id Packer)
#   export HCP_CLIENT_SECRET=$(vault kv get -namespace=admin -mount=kv -field=client_secret Packer)
#
# STEP 4 — Run the build:
#   cd packer/
#   packer init .
#   packer validate -var-file=student.pkrvars.hcl .
#   packer build   -var-file=student.pkrvars.hcl .
#
# ── Security rules ───────────────────────────────────────────────
#   student.pkrvars.hcl  is gitignored — NEVER commit it.
#   If you accidentally commit it, Vault Radar will block the push.
# ---------------------------------------------------------------

# ── Your student ID ──────────────────────────────────────────────
# Stamped into /etc/os-release on the golden image.
student_id = "student-XX"    # ← replace XX with your assigned number

# ── IBM Cloud API key ────────────────────────────────────────────
# Paste your IBM Cloud API key here.
# The lab instructor stores it in Vault — retrieve it with:
#   vault kv get -namespace=admin -mount=kv -field=ibm_api_key IBM_cloud
# Or leave empty ("") if you ran set-build-env.sh (it exports IBM_API_KEY).
ibm_api_key = ""

# ── IBM Cloud resource group ID ──────────────────────────────────
# Get it with: ibmcloud resource group <name> --id
ibm_resource_group_id = "b93f575887be43e894e861eb336485d3"

# ── Base RHEL 9 image ────────────────────────────────────────────
# Use a NON-minimal image for reliable SSH key injection.
# Check available images: ibmcloud is images --visibility public | grep rhel-9
base_image_name = "ibm-redhat-9-4-amd64-5"

# ── Image name prefix ────────────────────────────────────────────
# Timestamp is appended automatically: rhel92-golden-20260901050120-us-south
image_name_prefix = "rhel92-golden"

# ── Build region control ─────────────────────────────────────────
# false = us-south only (use for Task 1 testing)
# true  = both us-south + eu-de in parallel (use for full lab)
build_eu_de = false

# ── Subnet IDs ───────────────────────────────────────────────────
# Subnets must have a public gateway attached (needed for dnf updates).
# Instructor pre-creates these. Get IDs with:
#   ibmcloud is subnets | grep us-south
#   ibmcloud is subnets | grep eu-de
subnet_id_us_south = "0717-9b0c29d6-a257-4156-ba7a-f8f28f854019"
subnet_id_eu_de    = ""   # ← fill in when build_eu_de = true
