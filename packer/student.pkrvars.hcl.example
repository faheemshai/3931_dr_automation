# ---------------------------------------------------------------
# packer/student.pkrvars.hcl.example
#
# COPY to student.pkrvars.hcl and fill in your values.
#   cp student.pkrvars.hcl.example student.pkrvars.hcl
#
# student.pkrvars.hcl is gitignored — NEVER commit it.
#
# ── HCP Packer authentication — set in your shell, NOT here ──────
#
#   Retrieve from Vault and export before every packer build:
#
#   export HCP_CLIENT_ID=$(vault kv get -namespace=admin \
#     -mount=kv -field=client_id HCP_packer)
#   export HCP_CLIENT_SECRET=$(vault kv get -namespace=admin \
#     -mount=kv -field=client_secret HCP_packer)
#
# ── IBM Cloud API key — also from Vault ──────────────────────────
#
#   export IBM_API_KEY=$(vault kv get -namespace=admin \
#     -mount=kv -field=ibm_api_key IBM_cloud)
#
# ── Full build workflow ───────────────────────────────────────────
#
#   cd packer/
#   # export the three env vars above
#   packer init .
#   packer validate -var-file=student.pkrvars.hcl .
#   packer build   -var-file=student.pkrvars.hcl .
#
# ── After build ───────────────────────────────────────────────────
#   Image IDs are written to packer-manifest.json (gitignored).
#   Copy them into terraform/terraform.tfvars for Task 2:
#     golden_image_id_us_south = "..."
#     golden_image_id_eu_de    = "..."
# ---------------------------------------------------------------

# ── Student ID ───────────────────────────────────────────────────
student_id = "student-XX"    # ← replace XX with your assigned number

# ── IBM Cloud API key ────────────────────────────────────────────
# Leave empty to use the IBM_API_KEY env var (recommended):
ibm_api_key = ""

# ── IBM Cloud resource group ID ──────────────────────────────────
# ibmcloud resource group <name> --id
ibm_resource_group_id = ""   # ← e.g. "abc123def456abc123def456abc123de"

# ── Base RHEL 9.2 image ──────────────────────────────────────────
# ibmcloud is images --visibility public | grep -i rhel-9-2
base_image_name = "ibm-redhat-9-2-minimal-amd64-9"

# ── Image name prefix ────────────────────────────────────────────
image_name_prefix = "rhel92-golden"

# ── Build subnet IDs ─────────────────────────────────────────────
# These subnets must already exist with a public gateway attached.
# The lab instructor pre-creates them. Retrieve IDs with:
#   ibmcloud is subnets | grep us-south
#   ibmcloud is subnets | grep eu-de
subnet_id_us_south = ""      # ← e.g. "0717-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
subnet_id_eu_de    = ""      # ← e.g. "02c7-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
