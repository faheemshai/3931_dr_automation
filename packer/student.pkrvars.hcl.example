# ---------------------------------------------------------------
# packer/student.pkrvars.hcl.example
#
# COPY this file to student.pkrvars.hcl and fill in your values.
#   cp student.pkrvars.hcl.example student.pkrvars.hcl
#
# student.pkrvars.hcl is gitignored — NEVER commit it.
#
# ── HCP Packer authentication (set in your shell, NOT here) ──────
# HCP Packer uses a service principal. Export these env vars before
# running packer build — they are picked up automatically:
#
#   export HCP_CLIENT_ID="d74d3df1cded0965ef6b99ea4c3a2093"
#   export HCP_CLIENT_SECRET="<your-client-secret>"
#
# The client secret must be kept private. Store it in Vault:
#   vault kv put -namespace=admin -mount=kv HCP_packer \
#     client_id="d74d3df1cded0965ef6b99ea4c3a2093" \
#     client_secret="<your-client-secret>"
#
# Then export at build time:
#   export HCP_CLIENT_ID=$(vault kv get -field=client_id    kv/HCP_packer)
#   export HCP_CLIENT_SECRET=$(vault kv get -field=client_secret kv/HCP_packer)
#
# ── IBM Cloud API key ─────────────────────────────────────────────
# Retrieve from Vault, export, and reference below:
#   export IBM_API_KEY=$(vault kv get -field=ibm_api_key kv/IBM_cloud)
#
# ── Full build command ────────────────────────────────────────────
#   cd packer/
#   packer init .
#   packer build -var-file=student.pkrvars.hcl ./rhel92-ibmcloud.pkr.hcl
# ---------------------------------------------------------------

# ── Student ID ───────────────────────────────────────────────────
student_id = "student-XX"   # ← replace XX with your assigned number

# ── IBM Cloud API key ────────────────────────────────────────────
# Paste your short-lived key here — or use the env-var approach above.
ibm_api_key = ""            # ← e.g. from: vault kv get -field=ibm_api_key kv/IBM_cloud

# ── IBM Cloud resource group ID ──────────────────────────────────
# Retrieve: ibmcloud resource group <name> --id
ibm_resource_group_id = ""  # ← e.g. "abc123def456abc123def456abc123de"

# ── Base RHEL 9.2 image name ─────────────────────────────────────
# Confirm: ibmcloud is images --visibility public | grep -i rhel-9-2
base_image_name = "ibm-redhat-9-2-minimal-amd64-9"

# ── Image name prefix ────────────────────────────────────────────
# Timestamp is appended automatically: rhel92-golden-20260601-1430-us-south
image_name_prefix = "rhel92-golden"

# ── Build VPC names ──────────────────────────────────────────────
# Pre-created by the lab instructor. Each must have a subnet + public
# gateway in the target zone so dnf can reach the internet during the build.
build_vpc_name_us_south = "packer-build-vpc-us-south"
build_vpc_name_eu_de    = "packer-build-vpc-eu-de"

# ── Zone overrides (defaults match lab environment) ──────────────
us_south_zone = "us-south-1"
eu_de_zone    = "eu-de-2"
