# ---------------------------------------------------------------
# packer/student.pkrvars.hcl.example
#
# Copy this file to student.pkrvars.hcl (gitignored) and fill in
# your values before running packer build.
#
# Dedicated lab account IDs (already filled in below):
#   Resource group : 90733208e12b46eda9c4fbc130b8e426
#   us-south subnet: 0717-c20d5d2d-6216-4b99-88d7-8b441ef20a9e
#   eu-de subnet   : 02b7-df5e6a98-fa9c-4e87-b67c-057d360b62ba
#
# Credentials — set via environment variables before running packer:
#   export IBM_API_KEY=$(vault kv get -namespace=admin -mount=kv -field=ibm_api_key IBM_cloud)
#   export HCP_CLIENT_ID=$(vault kv get -namespace=admin -mount=kv -field=client_id Packer)
#   export HCP_CLIENT_SECRET=$(vault kv get -namespace=admin -mount=kv -field=client_secret Packer)
#
# Build command:
#   packer init .
#   packer validate -var-file=student.pkrvars.hcl .
#   packer build   -var-file=student.pkrvars.hcl .
# ---------------------------------------------------------------

# ── IBM API key ───────────────────────────────────────────────────
# Sourced from Vault at setup time by student-setup-env.sh.
# Never hardcode a real key here — the setup script writes it for you.
# ibm_api_key = "PASTE_KEY_HERE_ONLY_IF_RUNNING_WITHOUT_SETUP_SCRIPT"

# ── Student identity (stamped into /etc/os-release on the image) ──
student_id = "student-01"   # change to your assigned student number

# ── IBM Cloud resource group ──────────────────────────────────────
# Dedicated lab account — images are stored in this resource group
ibm_resource_group_id = "90733208e12b46eda9c4fbc130b8e426"

# ── us-south build subnet ─────────────────────────────────────────
# The temporary Packer build VSI is launched in this subnet.
# Subnet must have a public gateway attached for dnf internet access.
subnet_id_us_south = "0717-c20d5d2d-6216-4b99-88d7-8b441ef20a9e"

# ── eu-de build subnet ────────────────────────────────────────────
# DR region subnet — already filled in with the dedicated lab account value.
subnet_id_eu_de = "02b7-df5e6a98-fa9c-4e87-b67c-057d360b62ba"

# ── Build region control ──────────────────────────────────────────
# true  = build BOTH us-south (primary) AND eu-de (DR) in parallel
# false = us-south only (faster, use for quick single-region tests)
build_eu_de = true

# ── Base image ────────────────────────────────────────────────────
# IBM Cloud stock RHEL 9.4 image — Packer uses this as the build base.
base_image_name = "ibm-redhat-9-8-minimal-amd64-2"

# ── Image name prefix ────────────────────────────────────────────
# Compact timestamp is appended automatically: rhel92-golden-YYYYMMDDHHMMSS
image_name_prefix = "rhel92-golden"
