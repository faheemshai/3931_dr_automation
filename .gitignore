# ── Terraform state & local backend ─────────────────────────────
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# ── Sensitive variable overrides ─────────────────────────────────
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── SSH keys — NEVER commit private or public keys ───────────────
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
ent_demo_ed25519
ent_demo_ed25519.pub
*.priv

# ── OS / editor artefacts ─────────────────────────────────────────
.DS_Store
*.swp
*.swo
.idea/
.vscode/
.bob/

# ── Packer build artefacts ───────────────────────────────────────
packer/packer-manifest.json
packer/sbom/*.json
# packer/sbom/.gitkeep is intentionally tracked

# ── Packer student vars (auto-generated, personalised per student) ─
packer/student.pkrvars.hcl

# ── Student Vault tokens (NEVER commit — contains live Vault tokens)
student-tokens/

# ── Packer ephemeral SSH key directories (created/deleted per build) ─
# Packer generates temp RSA keypairs in packer/<timestamp>ssh_keys/
packer/*ssh_keys/
packer/ssh_keys/

# ── Student Vault token files (NEVER commit — contains live tokens) ─
scripts/student-tokens/

# ── HCP token cache (local auth state) ───────────────────────────
hcp_token.json
hcp_versions.json
